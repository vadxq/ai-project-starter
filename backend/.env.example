# HTTP 服务
APP_HTTP__BIND_ADDR=0.0.0.0:8080

# 数据库二选一；置空时只启动 HTTP。
APP_DATABASE__URL=postgres://starter:starter@localhost:5432/starter
# APP_DATABASE__URL=mysql://starter:starter@localhost:3306/starter?ssl-mode=required
APP_DATABASE__MAX_CONNECTIONS=10
APP_DATABASE__TIMEOUT_SECS=3

# 日志
APP_TELEMETRY__LOG_LEVEL=info
APP_TELEMETRY__JSON=false

# 业务认证：用 openssl rand -hex 32 生成，只在后端配置。
# APP_AUTH__JWT_SECRET=
