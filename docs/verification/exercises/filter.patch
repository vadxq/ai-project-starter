+#[tokio::test]
+#[ignore = "requires running PostgreSQL, imported Keycloak realm, and API"]
+async fn completed_filter_matches_real_database() {
+    let issuer = std::env::var("OIDC_ISSUER").unwrap();
+    let tokens = support::login(&issuer, "alice", "starter-spa").await;
+    let session = Session {
+        http: Client::new(),
+        base: std::env::var("TEST_API_URL").unwrap(),
+        token: tokens.access_token,
+    };
+    for completed in [false, true] {
+        let item: Value = session.request(Method::POST, "/api/v1/items", Some(json!({"title":"筛选演练","completed":completed})))
+            .await.json().await.unwrap();
+        let page: Value = session.request(Method::GET, &format!("/api/v1/items?limit=100&offset=0&completed={completed}"), None)
+            .await.json().await.unwrap();
+        let rows = page["items"].as_array().unwrap();
+        assert!(rows.iter().all(|row| row["completed"] == completed));
+        assert!(rows.iter().any(|row| row["id"] == item["id"]));
+        assert_eq!(session.request(Method::DELETE, &format!("/api/v1/items/{}?version=1", item["id"].as_str().unwrap()), None).await.status(), 204);
+    }
+    problem(session.request(Method::GET, "/api/v1/items?limit=20&offset=0&completed=invalid", None).await, 400, "validation_error").await;
+}
