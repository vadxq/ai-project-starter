{
  "name": "nextjs-ai-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run check:i18n && npm run typecheck && npm run build && npm run test:e2e",
    "ui:add": "shadcn add",
    "generate:api": "openapi-ts",
    "postbuild": "node scripts/prepare-standalone.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15",
    "@tanstack/react-query": "5.104.1"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "@hey-api/openapi-ts": "0.99.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core@1.16.13": true,
    "@parcel/watcher@2.5.6": true,
    "unrs-resolver@1.12.2": true
  }
}
