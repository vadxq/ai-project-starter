      "CreateItem": {
        "additionalProperties": false,
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "title": {
            "description": "After trimming leading/trailing ASCII space, TAB, CR and LF, title must contain 1–240 UTF-8 bytes.",
            "type": "string"
          }
        },
        "required": [
          "title",
          "completed"
        ],
        "type": "object"
      },
      "ErrorDetails": {
        "description": "上游 details 的已知字段，仅补充契约元数据，运行时仍保留可扩展 JSON 对象。",
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "rejection": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_status": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/ErrorDetails"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "HealthResponse": {
